# -----------------------------------------------------------------------------
# 🔒 CYBER-ARCHITECT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your secure production values.
# NEVER commit the real '.env' file to version control!
# -----------------------------------------------------------------------------

# Server Network Configuration
PORT=3001
# Set NODE_ENV in the deployment process, not this shared file. Vite also reads it at build time.

# Production Site URL & Domain Whitelist (CORS & CSP)
SITE_URL=https://www.ai.szantoi.hu
ALLOWED_ORIGINS=https://www.ai.szantoi.hu,https://ai.szantoi.hu,https://szantoi.hu,https://www.szantoi.hu,http://localhost:5173,http://localhost:3000
VITE_SITE_URL=https://www.ai.szantoi.hu

# Security & JWT Authentication
# Generate a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# Admin Initial Setup PIN (12-64 characters; replace this production-rejected placeholder)
ADMIN_DEFAULT_PIN=replace_with_a_strong_random_admin_pin

# MCP Master API Key (Optional: Headless CI/CD / Automated Agent Auth)
# PORTFOLIO_API_KEY=ca_live_your_random_secret_api_key_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=5
RATE_LIMIT_MAX_UPLINK=5

# Google Drive mirror / recovery configuration (optional). Google Drive is
# never the source of truth; canonical documents live in SQLite.
# Folder IDs may also be full https://drive.google.com/drive/folders/... URLs.
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_KNOWLEDGE_FOLDER_ID=
DRIVE_BLOG_FOLDER_ID=

# Development: absolute path to a local service-account JSON file.
# Container deployments: use a read-only secret mount outside /app and point
# this variable at the in-container path (for example /run/secrets/drive.json).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_PATH=
GOOGLE_OAUTH_TOKENS_PATH=
# Optional: development defaults to localhost; production derives this from SITE_URL.
GOOGLE_OAUTH_REDIRECT_URI=

# Canonical Obsidian Vault root. It must contain `Content/`, whose documents
# live as `<collection>/<slug>/index.md` packages. SQLite/RAG are projections
# from this Vault; mount it read-write only when using the admin Markdown editor.
CYBER_ARCHITECT_CONTENT_ROOT=

# Optional portable workspace data directory. It contains portfolio.sqlite,
# live WAL files, backups and the default DB-first document asset root. Exclude
# this folder from Obsidian Sync, OneDrive, Dropbox and Git.
# Precedence: SQLITE_DB_PATH > this value > SQLITE_DATA_DIR > app data/.
CYBER_ARCHITECT_WORKSPACE_DATA_DIR=

# Optional root for per-document non-text assets. Each canonical document gets
# an opaque child directory here. Do not expose this filesystem path to clients.
# Default: <database-directory>/content-assets.
CYBER_ARCHITECT_DOCUMENT_ASSET_DIR=

# Compatibility overrides. Prefer the workspace data directory above for a
# portable Vault; use SQLITE_DB_PATH only when an exact file is required.
SQLITE_DB_PATH=
SQLITE_DATA_DIR=

# Hybrid Obsidian → GraphRAG → operational SQL fact gateway (optional)
# The gateway is an internal, read-only API that accepts only an allowlisted
# project ID and fact profiles. Do not put a PostgreSQL/MS SQL connection string
# or raw SQL here. In production this URL must use HTTPS.
HYBRID_SQL_FACT_GATEWAY_URL=
HYBRID_SQL_FACT_GATEWAY_TOKEN=
HYBRID_SQL_FACT_GATEWAY_TIMEOUT_MS=4000
