{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "server/scripts/*.js",
    "server/tests/*.js"
  ],
  "project": [
    "src/**/*.{js,jsx,css}",
    "server/**/*.js"
  ],
  "ignoreDependencies": [
    "postcss",
    "lint-staged"
  ],
  "treatConfigHintsAsErrors": true,
  "ignoreExportsUsedInFile": true
}
